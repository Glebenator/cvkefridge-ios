      "comment" : "The quantity of a food, the icon of its status, and its days left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%2$@ %3$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "A food and the text that tells it from other foods.\nFor VoiceOver: a food and the alias that agrees with the typed name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@, %@, %@" : {
      "comment" : "For VoiceOver: one History entry. The values are the food, the quantity, Used or Thrown away, and the day.",
