{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%@ Select the field to enter the printed date." : {
      "comment" : "The value says where an estimated date comes from."
    },
    "%@ added" : {
      "comment" : "The value is the name of a food."
    },
    "%@ and %lld more" : {
      "comment" : "A list of names of food, and the number of foods that are not in the list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$lld more"
          }
        }
      }
    },
    "%@ bottle" : {
      "comment" : "A quantity of 1 bottle. The value is the formatted number."
    },
    "%@ bottles" : {
      "comment" : "A quantity in bottles, also with a fraction. The value is the formatted number."
    },
    "%@ cup" : {
      "comment" : "A quantity of 1 cup. The value is the formatted number."
    },
    "%@ cups" : {
      "comment" : "A quantity in cups, also with a fraction. The value is the formatted number."
    },
    "%@ deleted" : {
      "comment" : "The value is the name of a food or of a storage area."
    },
    "%@ g" : {
      "comment" : "A quantity with its unit. The value is a number."
    },
    "%@ has %lld item. Move it to a different storage area, or record it as used or thrown away. Then delete the storage area." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$lld item. Move it to a different storage area, or record it as used or thrown away. Then delete the storage area."
          }
        }
      }
    },
    "%@ has %lld items. Move them to a different storage area, or record them as used or thrown away. Then delete the storage area." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$lld items. Move them to a different storage area, or record them as used or thrown away. Then delete the storage area."
          }
        }
      }
    },
    "%@ has food in it" : {
      "comment" : "The value is the name of a storage area."
    },
    "%@ kg" : {
      "comment" : "A quantity with its unit. The value is a number."
    },
    "%@ l" : {
      "comment" : "A quantity with its unit. The value is a number."
    },
    "%@ ml" : {
      "comment" : "A quantity with its unit. The value is a number."
    },
    "%@ now expires on %@" : {
      "comment" : "A message. The values are the name of a food and a date.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ now expires on %2$@"
          }
        }
      }
    },
    "%@ of %@ thrown away" : {
      "comment" : "For example: 200 g of Baby spinach thrown away.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ thrown away"
          }
        }
      }
    },
    "%@ of %@ used" : {
      "comment" : "For example: 1.5 l of Whole milk used.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ used"
          }
        }
      }
    },
    "%@ pack" : {
      "comment" : "A quantity of 1 pack. The value is the formatted number."
    },
    "%@ packs" : {
      "comment" : "A quantity in packs, also with a fraction. The value is the formatted number."
    },
    "%@ pcs" : {
      "comment" : "A quantity with its unit. The value is a number."
    },
    "%@ saved" : {
      "comment" : "The value is the name of a food that the person edited."
    },
    "%@ slice" : {
      "comment" : "A quantity of 1 slice. The value is the formatted number."
    },
    "%@ slices" : {
      "comment" : "A quantity in slices, also with a fraction. The value is the formatted number."
    },
    "%@ with no unit" : {
      "comment" : "A sum of quantities of food that has no unit. The value is a number.\nA sum of the quantities of foods that have no unit."
    },
